# Primary Elysium RPC. For production and acceptance, use an Alchemy archive endpoint:
# https://elysium-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Leave unset to boot against the official public RPC with a temporary / non-production label.
# ELYSIUM_RPC_URL=
# Optional backup RPC
# ELYSIUM_RPC_URL_BACKUP=

PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/lp-atlas.db

# Backend scans immediately after listening, then every 5 minutes (per-chain busy scans are skipped).
# Disable and restart the API to return to manual-only refresh.
AUTO_SCAN_ENABLED=true
# Admission limits (MiB), including SQLite -wal/-shm side files.
SCAN_MAX_DATABASE_MB=2048
SCAN_MIN_FREE_DISK_MB=512

# Optional. Required only when an official-index adapter is later called.
# Never fall back to a public unofficial Graph gateway if this is unset.
# THE_GRAPH_API_KEY=

# Optional per-chain archival / primary RPC URLs. Not required to start the server.
# Do not treat a public RPC as an acceptance source.
# BSC_RPC_URL=
# BSC_RPC_URL_BACKUP=
# ETHEREUM_RPC_URL=
# ETHEREUM_RPC_URL_BACKUP=
# BASE_RPC_URL=
# BASE_RPC_URL_BACKUP=
# ROBINHOOD_RPC_URL=
# ROBINHOOD_RPC_URL_BACKUP=

# Optional official subgraph IDs. Pancake V3 BSC may use the ID published on
# https://developer.pancakeswap.finance/apis/subgraph
# PANCAKE_V3_BSC_SUBGRAPH_ID=
# Uniswap Labs production IDs are not confirmed. Leave unset rather than
# filling a public Explorer example ID and calling it official.
# UNISWAP_V3_ETHEREUM_SUBGRAPH_ID=
# UNISWAP_V4_ETHEREUM_SUBGRAPH_ID=
# UNISWAP_V3_BASE_SUBGRAPH_ID=
# UNISWAP_V4_BASE_SUBGRAPH_ID=

# Opt in only after migration/backup and deployment approval (plan 18).
SOLANA_DLMM_ENABLED=false
