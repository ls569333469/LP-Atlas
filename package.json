{
	"name": "lp-atlas",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"packageManager": "pnpm@10.34.6",
	"scripts": {
		"dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
		"dev:api": "tsx watch src/server/index.ts",
		"dev:web": "vite --config src/web/vite.config.ts",
		"build": "pnpm build:api && pnpm build:web",
		"build:api": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/store/migrations', 'dist/store/migrations', { recursive: true });\"",
		"build:web": "vite build --config src/web/vite.config.ts",
		"start": "node dist/server/index.js",
		"test": "vitest run",
		"research:signals": "tsx research/run.ts",
		"research:lifecycle": "tsx research/run-lifecycle.ts",
		"check": "biome check . && tsc -p tsconfig.node.json --noEmit && tsc -p src/web/tsconfig.json --noEmit && tsc -p research/tsconfig.json --noEmit"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"decimal.js": "^10.6.0",
		"dotenv": "^18.0.10",
		"fastify": "^5.12.8",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"viem": "^2.57.18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^20.19.25",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"concurrently": "^10.0.7",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vitest": "^3.2.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
